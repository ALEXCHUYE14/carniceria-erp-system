# Copia este archivo a .env.local y completa con los datos de tu proyecto Supabase
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-publishable-o-anon
# Identificador de la caja/terminal (puede cambiarse luego en Configuración > Dispositivos)
VITE_DEFAULT_TERMINAL_ID=CAJA-1
# WhatsApp de soporte del login (opcional; 9 dígitos = Perú). Por defecto: 924996961
VITE_SUPPORT_WHATSAPP=924996961
